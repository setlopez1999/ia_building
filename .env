# Variables de entorno — WiFi Speed App
# Usar con: fvm flutter run --dart-define-from-file=.env
#
# IMPORTANTE: reemplazar BASE_URL por la URL real del backend antes de producción.
# Para producción, NO subir este archivo al repo (agregar .env a .gitignore).

BASE_URL=http://serverpruebabryan.com.cd-latam.com
APP_DEBUG=true

